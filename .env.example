FGCHAT_SECRET_KEY=
FGCHAT_HOST=127.0.0.1
FGCHAT_PORT=5000
FGCHAT_COOKIE_SECURE=0
DATABASE_URL=sqlite:///fgchat.sqlite3
# Use a trusted TURN service for reliable calls across restrictive networks.
FGCHAT_TURN_URL=
FGCHAT_TURN_USERNAME=
FGCHAT_TURN_CREDENTIAL=
# For multi-worker deployment, configure Redis. The same URL backs Socket.IO and presence/call state.
FGCHAT_SOCKETIO_REDIS_URL=
FGCHAT_SOCKETIO_MODE=threading
POSTGRES_PASSWORD=
# Optional coturn REST API shared secret; the app then issues one-hour ICE credentials.
FGCHAT_TURN_SHARED_SECRET=
